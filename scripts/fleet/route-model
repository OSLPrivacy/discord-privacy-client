#!/usr/bin/env python3
"""Select an unexpired evidence-backed model route."""
from __future__ import annotations
import argparse
import json
import sys
from datetime import UTC, datetime
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument("task_class")
parser.add_argument("--table", type=Path, required=True)
parser.add_argument("--at", help="UTC ISO-8601 time, for reproducible checks")
args = parser.parse_args()
try:
    table = json.loads(args.table.read_text(encoding="utf-8"))
    now = datetime.fromisoformat((args.at or datetime.now(UTC).isoformat()).replace("Z", "+00:00"))
    expires = datetime.fromisoformat(table["expires_at"].replace("Z", "+00:00"))
    if table.get("format") != "osl-model-routing-v1" or now >= expires:
        raise ValueError("routing evidence is absent or expired; re-run the benchmark")
    route = table["routes"][args.task_class]
except (OSError, ValueError, KeyError, json.JSONDecodeError) as exc:
    print(f"route-model: {exc}", file=sys.stderr)
    raise SystemExit(2)
print(route["profile"])
