+
+fn task_0282b_restore_places_on_unblock(allowed_place_dir: Option<&Path>, person_id: &str) {
+    let Some(dir) = allowed_place_dir else {
+        return;
+    };
+    let mut stash = TASK_0282B_STASHED_PLACES
+        .lock()
+        .unwrap_or_else(|error| error.into_inner());
+    let mine = stash
+        .iter()
+        .filter(|(person, _)| person == person_id)
+        .map(|(_, record)| record.clone())
+        .collect::<Vec<_>>();
+    stash.retain(|(person, _)| person != person_id);
+    drop(stash);
+    for record in mine {
+        eprintln!(
+            "TASK_0282B_RESTORED person={person_id} app={} account={} kind={} stable_id={} place_name=\"{}\"",
+            record.app, record.account, record.kind, record.stable_id, record.place_name
+        );
+        let _ = crate::allowed_places::add_allowed_place_record(dir, record);
+    }
+}
