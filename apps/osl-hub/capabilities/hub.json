{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hub-local",
  "description": "WhatsApp Desktop QA only: production unlock, exact existing-session claim, and local owner-window controls.",
  "webviews": ["main"],
  "local": true,
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-get-core-readiness",
    "allow-unlock-hub-password-gate",
    "allow-claim-whatsapp-qa-window",
    "allow-resize-whatsapp-qa-window",
    "allow-get-whatsapp-qa-protection-status"
  ]
}
