{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "osl-network",
  "description": "Explicit network-reachable OSL commands for the trusted main window: signed OSL Mail capability/provisioning requests and authenticated SESSION_RESET delivery.",
  "webviews": [
    "main"
  ],
  "local": true,
  "permissions": [
    "allow-osl-mail-get-status",
    "allow-osl-mail-provision",
    "allow-osl-mail-list-threads",
    "allow-osl-mail-send",
    "allow-osl-mail-plan-protected-forward",
    "allow-osl-mail-forward-protected",
    "allow-osl-mail-burn",
    "allow-emit-active-session-reset",
    "allow-add-hub-friend-by-username"
  ]
}
