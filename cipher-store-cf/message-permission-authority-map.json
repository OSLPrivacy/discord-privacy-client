    {"id":"link-read","route":"POST /v/:id/fetch","authority":"body fetch token plus same-origin and trusted-gesture boundary","handler":"handleLinkFetch","auth_anchor":"readTokenBody(request)","runtime_trace":"test/message-permission-map.test.ts:link-read"},
    {"id":"link-recipient-delete","route":"POST /v/:id/burn","authority":"body fetch token plus same-origin boundary","handler":"handleLinkBurn","auth_anchor":"originOk(request)","runtime_trace":"test/message-permission-map.test.ts:link-recipient-delete"},
    {"id":"link-sender-delete","route":"DELETE /v1/link/:id","authority":"body x-osl-manage-token (sender management capability)","handler":"handleLinkRevoke","auth_anchor":"manage_token_sha256_hex","runtime_trace":"test/message-permission-map.test.ts:link-sender-delete"},
